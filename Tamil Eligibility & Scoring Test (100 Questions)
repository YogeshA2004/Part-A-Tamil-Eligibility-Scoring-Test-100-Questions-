<!doctype html>
<html lang="ta">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Part A: Tamil Eligibility & Scoring Test</title>
  <style>
    :root {
      --ink: #1f2933;
      --muted: #5f6f7f;
      --line: #d9e2ec;
      --brand: #155e75;
      --brand-soft: #e0f2fe;
      --ok: #0f766e;
      --bad: #b91c1c;
      --paper: #ffffff;
      --page: #f6f8fb;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--page);
      color: var(--ink);
      font-family: "Nirmala UI", Latha, Arial, sans-serif;
      line-height: 1.5;
    }
    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      padding: 14px 18px;
    }
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      max-width: 1100px;
      margin: 0 auto;
    }
    h1 {
      color: #0f3f56;
      font-size: 22px;
      line-height: 1.25;
      margin: 0;
    }
    .score {
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--brand);
      font-weight: 700;
      padding: 8px 10px;
      white-space: nowrap;
    }
    main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 18px;
    }
    .controls {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }
    button {
      appearance: none;
      border: 1px solid var(--brand);
      background: var(--brand);
      border-radius: 8px;
      color: white;
      cursor: pointer;
      font: inherit;
      font-weight: 700;
      padding: 9px 13px;
    }
    button.secondary {
      background: white;
      color: var(--brand);
    }
    .question {
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 8px;
      margin-bottom: 12px;
      padding: 14px;
    }
    .question h2 {
      font-size: 17px;
      margin: 0 0 10px;
    }
    .options {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    label {
      align-items: flex-start;
      border: 1px solid var(--line);
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      gap: 8px;
      min-height: 48px;
      padding: 9px;
    }
    input { margin-top: 4px; }
    .letter { color: var(--brand); font-weight: 700; min-width: 20px; }
    .correct {
      border-color: #5eead4;
      background: #ecfdf5;
    }
    .wrong {
      border-color: #fecaca;
      background: #fff1f2;
    }
    .result {
      color: var(--muted);
      font-weight: 700;
      margin-top: 8px;
      min-height: 22px;
    }
    .result.ok { color: var(--ok); }
    .result.bad { color: var(--bad); }
    @media (max-width: 720px) {
      .topbar { align-items: flex-start; flex-direction: column; }
      .options { grid-template-columns: 1fr; }
      h1 { font-size: 19px; }
    }
    @media print {
      header { position: static; }
      .controls { display: none; }
      body { background: white; }
      .question { break-inside: avoid; }
    }
  </style>
</head>
<body>
  <header>
    <div class="topbar">
      <h1>Part A: Tamil Eligibility & Scoring Test (100 Questions)</h1>
      <div class="score" id="score">Score: 0 / 100</div>
    </div>
  </header>
  <main>
    <div class="controls">
      <button id="submit" type="button">Submit Quiz</button>
      <button id="reset" class="secondary" type="button">Reset</button>
      <button id="answers" class="secondary" type="button">Show Answers</button>
    </div>
    <div id="quiz"></div>
  </main>
