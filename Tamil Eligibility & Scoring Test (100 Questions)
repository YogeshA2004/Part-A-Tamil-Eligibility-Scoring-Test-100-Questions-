"C":"அவள் பள்ளிக்கு சென்றான்","D":"நான் பள்ளிக்கு சென்றான்"},"answer":"B"},{"number":95,"question":"பிழையைத் திருத்துக: \"அவள் புத்தகம் படித்தான்.\"","options":{"A":"அவள் புத்தகம் படித்தான்","B":"அவன் புத்தகம் படித்தாள்","C":"அவள் புத்தகம் படித்தாள்","D":"நான் புத்தகம் படித்தாள்"},"answer":"C"},{"number":96,"question":"பிழையைத் திருத்துக: \"நான் நாளை வந்தேன்.\"","options":{"A":"நான் நாளை வந்தேன்","B":"நான் நேற்று வருவேன்","C":"நான் நாளை வந்தான்","D":"நான் நாளை வருவேன்"},"answer":"D"},{"number":97,"question":"\"நீர் உயிர்க்கு அவசியம்\" என்ற வாக்கியத்தின் கருத்து என்ன?","options":{"A":"உயிர்கள் வாழ நீர் தேவை","B":"மரம் நடுதல் தீங்கு","C":"கல்வி தேவையில்லை","D":"ஒற்றுமை பலமல்ல"},"answer":"A"},{"number":98,"question":"\"மரம் நட்டால் மழை பெருகும்\" என்ற வாக்கியம் எதை வலியுறுத்துகிறது?","options":{"A":"நீர் வீணாக்குதலை","B":"மரம் நடுவதின் சுற்றுச்சூழல் பயனை","C":"போர் புகழை","D":"கல்வியின் குறையை"},"answer":"B"},{"number":99,"question":"\"தமிழ் மொழி இனிமையானது\" என்ற வாக்கியத்தில் பண்புச் சொல் எது?","options":{"A":"தமிழ்","B":"மொழி","C":"இனிமையானது","D":"தமிழ் மொழி"},"answer":"C"},{"number":100,"question":"\"முயற்சி வெற்றியைத் தரும்\" என்ற வாக்கியத்தின் கருத்து என்ன?","options":{"A":"முயற்சி பயனில்லை","B":"வெற்றி சாத்தியமில்லை","C":"அறிவு தேவையில்லை","D":"முயன்றால் வெற்றி கிடைக்கும்"},"answer":"D"}];
    const quiz = document.getElementById("quiz");
    const score = document.getElementById("score");

    function render() {
      quiz.innerHTML = questions.map((item) => {
        const options = Object.entries(item.options).map(([letter, text]) => `
          <label data-question="${item.number}" data-letter="${letter}">
            <input type="radio" name="q${item.number}" value="${letter}">
            <span class="letter">${letter}.</span>
            <span>${text}</span>
          </label>
        `).join("");
        return `
          <section class="question" id="q${item.number}">
            <h2>${item.number}. ${item.question}</h2>
            <div class="options">${options}</div>
            <div class="result" id="r${item.number}"></div>
          </section>
        `;
      }).join("");
      score.textContent = "Score: 0 / 100";
    }

    function clearMarks() {
      document.querySelectorAll("label").forEach((label) => {
        label.classList.remove("correct", "wrong");
      });
      document.querySelectorAll(".result").forEach((result) => {
        result.textContent = "";
        result.className = "result";
      });
    }

    function submitQuiz(showOnlyAnswers = false) {
      clearMarks();
      let total = 0;
      questions.forEach((item) => {
        const selected = document.querySelector(`input[name="q${item.number}"]:checked`);
        const selectedValue = selected ? selected.value : "";
        const correctLabel = document.querySelector(`label[data-question="${item.number}"][data-letter="${item.answer}"]`);
        const result = document.getElementById(`r${item.number}`);
        correctLabel.classList.add("correct");

        if (showOnlyAnswers) {
          result.textContent = `Answer: ${item.answer}`;
          result.classList.add("ok");
          return;
        }

        if (selectedValue === item.answer) {
          total += 1;
          result.textContent = "Correct";
          result.classList.add("ok");
        } else {
          if (selected) selected.closest("label").classList.add("wrong");
          result.textContent = selectedValue ? `Wrong. Answer: ${item.answer}` : `Not answered. Answer: ${item.answer}`;
          result.classList.add("bad");
        }
      });
      if (!showOnlyAnswers) score.textContent = `Score: ${total} / ${questions.length}`;
    }

    document.getElementById("submit").addEventListener("click", () => submitQuiz(false));
    document.getElementById("answers").addEventListener("click", () => submitQuiz(true));
    document.getElementById("reset").addEventListener("click", () => {
      document.querySelectorAll("input[type=radio]").forEach((input) => { input.checked = false; });
      clearMarks();
      score.textContent = "Score: 0 / 100";
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    render();
  </script>
